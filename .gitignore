# Secrets
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
service-account*.json

# OS and editor
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp

# Book files — never commit source books or e-reader dumps
*.epub
*.mobi
*.azw
*.azw3
*.djvu
*.fb2

# PDFs are treated as books everywhere except generated reports
*.pdf
!collections/**/outputs/*.pdf

# Local copies for owner + agent — any format. Only local/README.md is tracked.
local/*
!local/README.md

# Other local scratch
tmp/
scratch/
*.zip
